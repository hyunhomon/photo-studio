# This is a configuration INVENTORY, not runnable until apps are scaffolded.
# Keep per-Worker secrets in Wrangler secret store / .dev.vars (never commit).

# Web / API base URLs (edit during scaffold)
PUBLIC_WEB_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787
ALLOWED_WEB_ORIGINS=http://localhost:4321

# OpenRouter OAuth server callback (must match the authorize flow)
OPENROUTER_CALLBACK_URL=http://localhost:8787/auth/openrouter/callback
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model slugs: this image model is an agreed default; analysis slug is undecided.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_ANALYSIS_MODEL=REPLACE_WITH_VERIFIED_LOW_COST_MULTIMODAL_MODEL
OPENROUTER_EVALUATION_MODEL=REPLACE_WITH_VERIFIED_LOW_COST_MULTIMODAL_MODEL

# Secret names ONLY: generate your own values, never commit.
# APP_ENCRYPTION_KEY_B64=...   # AES-256-GCM key (32 random bytes, base64)
# SESSION_SECRET=...           # secure random value, if required by chosen session mechanism
# INVITE_SEED_CODES=...        # optional one-time bootstrap, do not commit real codes

# Cloudflare bindings are provisioned via Wrangler (not API tokens in browser).
# DB = D1; ASSETS = R2; STUDIO_WORKFLOW = Workflow
# Create local .dev.vars for the API Worker when scaffolding.
