# Configuration map only. Apps do NOT load this root file automatically.
# Phase 0 starts with checked-in non-secret defaults and no credentials.
# Remote production settings are generated by bun run deploy from infra/production.json.

# Browser config: apps/web/.env (see apps/web/.env.example)
PUBLIC_API_URL=http://localhost:8787

# API defaults: apps/api/wrangler.jsonc; override in apps/api/.dev.vars.
AI_MODE=mock
ALLOWED_WEB_ORIGINS=http://localhost:4321
OPENROUTER_CALLBACK_URL=http://localhost:8787/auth/openrouter/callback
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
# Unselected until capability validation in later phases.
OPENROUTER_ANALYSIS_MODEL=""
OPENROUTER_EVALUATION_MODEL=""

# Phase 1 server secret only (not needed or consumed by Phase 0):
# APP_ENCRYPTION_KEY_B64=  # 32 random bytes, base64; versioned AES-GCM storage
# Session/bootstrap secrets will be finalized in Phase 1.

# API local bindings: DB (D1), ASSETS (private R2), STUDIO_WORKFLOW.
# Local-only database ID in wrangler.jsonc is not a deployment resource ID.
# Never place secrets in PUBLIC_* variables or shared operator inference keys.
