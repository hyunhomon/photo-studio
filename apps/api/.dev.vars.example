# Local Mock development. setup-local generates an ignored encryption secret; no operator inference key.
# Optional licensed reference source. Keep disabled until the API agreement covers this use.
# REFERENCE_SOURCE=shutterstock
# SHUTTERSTOCK_ACCESS_TOKEN= (server secret; never commit a value)
# SHUTTERSTOCK_SUBSCRIPTION_ID=
# SHUTTERSTOCK_LICENSE=platform
# SHUTTERSTOCK_AI_REFERENCE_APPROVED=true
# SHUTTERSTOCK_AGREEMENT_VERSION=
AI_MODE=mock
ALLOWED_WEB_ORIGINS=http://localhost:4321
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CALLBACK_URL=http://localhost:8787/auth/openrouter/callback
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_ANALYSIS_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EVALUATION_MODEL=google/gemini-2.5-flash
# Phase 1 only: generate a private 32-byte key, never paste it into source/chat.
# APP_ENCRYPTION_KEY_B64=

