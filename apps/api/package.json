{
  "name": "@photo-studio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/setup-local.ts && wrangler dev --local --ip localhost --port 8787 --log-level error",
    "cf:types": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "bun run cf:types && tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@jsquash/png": "3.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/webp": "1.5.0",
    "@photo-studio/ai": "workspace:*",
    "@photo-studio/db": "workspace:*",
    "@photo-studio/schemas": "workspace:*",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "wrangler": "4.159.0"
  }
}
