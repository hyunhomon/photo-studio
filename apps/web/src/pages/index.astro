---
import Layout from "../layouts/Layout.astro";
import LandingWorkspace from "../components/LandingWorkspace.astro";
import { BrandLockup } from "@photo-studio/ui";
const steps = [
  {
    number: "01",
    title: "상품 사진을 올리세요",
    body: "정면부터 디테일까지. 한 상품의 사진을 함께 보고 시작해요.",
  },
  {
    number: "02",
    title: "원하는 장면을 정하세요",
    body: "레퍼런스와 함께 기획하고, 빛·인물·소재를 직접 조정해요.",
  },
  {
    number: "03",
    title: "한 컷씩 만들고 비교하세요",
    body: "생성을 승인한 뒤 원본과 비교하고, 필요한 부분만 다시 다듬어요.",
  },
];
---

<Layout
  title="상품 사진으로, 다음 컷을 시작하세요"
  description="상품 사진을 올리고 원하는 촬영을 기획하세요. 원본과 생성 결과를 한 작업대에서 비교하며 만드는 AI 패션 스튜디오."
>
  <header class="page-width flex min-h-24 items-center justify-between gap-6">
    <a href="/" aria-label="Photo Studio 홈" class="py-3">
      <BrandLockup />
    </a>
    <a
      href="/studio"
      class="inline-flex min-h-11 shrink-0 items-center gap-3 rounded-lg px-3 text-sm font-medium whitespace-nowrap text-muted hover:bg-surface hover:text-ink"
    >
      스튜디오 열기 <span aria-hidden="true">↗</span>
    </a>
  </header>
  <main id="main">
    <section class="page-width grid items-center gap-12 pt-12 pb-16 sm:pt-20 sm:pb-24 lg:min-h-[710px] lg:grid-cols-[0.95fr_1.05fr] lg:gap-14 lg:pt-14">
      <div class="max-w-xl">
        <p class="mb-6 text-xs font-semibold tracking-[0.17em] text-primary">
          YOUR NEXT SHOT
        </p>
        <h1 class="text-[clamp(2.8rem,5vw,4.75rem)] leading-[1.2] font-semibold tracking-[-0.065em]">
          한 벌의 사진으로,
          <br />
          다음 <span class="text-primary">컷의 시작.</span>
        </h1>
        <p class="mt-7 max-w-md text-base leading-8 text-muted sm:text-lg">
          <span class="block">상품 사진을 올리고, 원하는 장면을 정하세요.</span>
          <span class="block">기획부터 원본 비교까지 하나의 작업대에서.</span>
        </p>
        <a
          href="/studio"
          class="pill-link mt-9 min-h-14 w-full max-w-80 justify-between px-6 text-base sm:w-auto sm:max-w-none sm:gap-9"
        >
          사진으로 촬영 시작하기 <span aria-hidden="true">↗</span>
        </a>
        <p class="mt-4 text-xs leading-6 text-muted">
          OpenRouter 계정으로 연결해요.
          <br />
          사진 등록만으로 AI 비용이 발생하지 않아요.
        </p>
      </div>
      <LandingWorkspace />
    </section>
    <section
      aria-labelledby="process-heading"
      class="border-t border-line py-16 sm:py-20"
    >
      <div class="page-width">
        <h2
          id="process-heading"
          class="text-2xl leading-relaxed font-semibold tracking-tight sm:text-3xl"
        >
          촬영에 필요한 것만, 차례대로.
        </h2>
        <ol class="mt-10 grid gap-9 sm:grid-cols-3 sm:gap-8">
          {steps.map((step) => (
            <li class="border-t border-line pt-5">
              <span class="text-xs font-semibold text-primary">
                {step.number}
              </span>
              <h3 class="mt-5 text-base font-semibold sm:text-lg">
                {step.title}
              </h3>
              <p class="mt-3 max-w-sm text-sm leading-7 text-muted">
                {step.body}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <aside
      aria-label="AI 비용 안내"
      class="page-width flex flex-col gap-4 border-t border-line py-9 text-sm sm:flex-row sm:items-start sm:justify-between sm:gap-12"
    >
      <p class="shrink-0 font-semibold">내 계정으로, 필요한 한 컷만.</p>
      <p class="max-w-2xl text-xs leading-7 text-muted">
        비용은 본인의 OpenRouter 크레딧에서 청구돼요. 분석·기획과 이미지 생성은
        각각 비용 안내에 동의한 뒤 실행하며, 서비스 자체 결제나 구독은 없어요.
      </p>
    </aside>
  </main>
  <footer class="page-width flex flex-wrap items-center justify-between gap-4 border-t border-line py-7 text-xs text-muted">
    <span>PHOTO STUDIO © 2026</span>
    <a
      href="/privacy"
      class="min-h-11 py-3 underline-offset-4 hover:text-ink hover:underline"
    >
      사진과 데이터 보관 안내
    </a>
  </footer>
</Layout>
