{
  "name": "photo-studio",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Clothing photography studio — Cloudflare-first web MVP",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "dev:web": "bun run --filter @photo-studio/web dev",
    "dev:api": "bun run --filter @photo-studio/api dev",
    "typecheck": "tsc -p tsconfig.tools.json && bun run --sequential --filter '@photo-studio/*' typecheck",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test apps/api/src packages",
    "test:local": "bun run scripts/local-smoke.ts",
    "test:oauth": "bun run scripts/oauth-local-smoke.ts",
    "test:photography": "bun run scripts/photography-benchmark.ts",
    "test:e2e": "playwright test",
    "build": "bun run --sequential --filter './apps/*' build",
    "deploy": "bun run check && bun run scripts/deploy-production.ts",
    "deploy:web": "bun run check && bun run scripts/deploy-web-production.ts",
    "test:production": "node scripts/production-smoke.ts",
    "test:production:e2e": "bun run scripts/production-e2e.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "cf:types": "bun run --filter @photo-studio/api cf:types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
